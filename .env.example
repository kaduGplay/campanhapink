VOIDPAY_PUBLIC_KEY=
VOIDPAY_SECRET_KEY=
PORT=58327
HOST=127.0.0.1

# Token interno fixo, compartilhado por todas as vendas.
# O mesmo valor precisa ser enviado pela VoidPay em payload.token.
GATEWAY_WEBHOOK_TOKEN=
# URL HTTPS pública desta instalação. Não use localhost.
PUBLIC_BASE_URL=

# Obrigatório na Vercel: conectar Upstash Redis e usar as credenciais REST.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Opcional: namespace estável do banco (não use um valor novo a cada deploy).
# PINK_STORAGE_PREFIX=campanha-pink:production
